+        strcmp(serverInfo->rtspSessionUrl, "rtspenc://127.0.0.1:48010") != 0 ||
+        streamConfig->controlOnly || streamConfig->enableMic) {
+        return LI_MANAGED_POLICY_ERR_MODE;
+    }
+    if (!policy->isLive(policy->context)) {
+        return LI_MANAGED_POLICY_ERR_CALLBACK;
+    }
+    return startConnection(serverInfo, streamConfig, clCallbacks, drCallbacks, arCallbacks,
+                           renderContext, drFlags, audioContext, arFlags, policy);
