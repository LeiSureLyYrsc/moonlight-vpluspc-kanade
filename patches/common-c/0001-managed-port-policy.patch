+    void* audioContext, int arFlags, const LI_MANAGED_PORT_POLICY* policy) {
+    if (policy == NULL || policy->enable != 1 || policy->isLive == NULL || policy->context == NULL) {
+        return LI_MANAGED_POLICY_ERR_MISSING;
+    }
+    if (policy->videoPort != 47998 || policy->controlPort != 47999 || policy->audioPort != 48000) {
+        return LI_MANAGED_POLICY_ERR_PORT;
+    }
+    if (serverInfo == NULL || streamConfig == NULL || serverInfo->address == NULL ||
+        serverInfo->serverInfoAppVersion == NULL || strcmp(serverInfo->serverInfoAppVersion, "7.1.431.-1") != 0 ||
