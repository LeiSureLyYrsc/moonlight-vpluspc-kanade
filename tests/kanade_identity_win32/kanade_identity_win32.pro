QT += core concurrent testlib
QT -= gui
CONFIG += console c++17
CONFIG -= app_bundle

TARGET = kanade_identity_win32_test
TEMPLATE = app

# Windows-only acceptance tests for the REAL Kanade installation identity store:
# DPAPI current-user sealing, the private current-user + SYSTEM DACL,
# handle-pinned reparse rejection, atomic replace, scope isolation and
# concurrent access.
#
# This target exists only on Windows desktop builds.  It defines the module
# test hooks (introspection used by the negative cases) and never a weaker
# store; the product build defines neither macro.
#
# Every root is a private scratch directory on an approved non-system volume
# (the CI runner's reserved D: root, or KANADE_DPAPI_TEST_ROOT /
# KANADE_IDENTITY_TEST_ROOT).  Identities are throwaway keys generated by the
# module under test; nothing touches the network, TLS, Kanade or a real
# account.

win32:!winrt {
    INCLUDEPATH += $$PWD/../../app

    DEFINES += KANADE_IDENTITY_TEST_HOOKS

    SOURCES += \
        main.cpp \
        ../../app/backend/kanade/kanadeidentity.cpp

    HEADERS += \
        ../../app/backend/kanade/kanadeidentity.h

    INCLUDEPATH += $$PWD/../../libs/windows/include $$PWD/../../libs/windows/include/x64
    LIBS += -L$$PWD/../../libs/windows/lib/x64
    LIBS += -llibcrypto
    LIBS += crypt32.lib advapi32.lib
} else {
    # Nothing to test on a non-Windows host: keep qmake honest instead of
    # producing a target that would pass by skipping everything.
    error("kanade_identity_win32 is a Windows-only target")
}
